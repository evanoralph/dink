# Staging env contract (P0-09)
# Copy values into:
# - Meteor staging host env
# - Vercel project "Preview" / staging env
# Do NOT commit real secrets.

# --- Shared ---
# Replace placeholders after you create Atlas + hosts.
STAGING_WEB_URL=https://staging.yourdomain.com
STAGING_API_URL=https://api-staging.yourdomain.com

# --- Meteor API (staging host) ---
ROOT_URL=https://api-staging.yourdomain.com
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/dink_staging?retryWrites=true&w=majority
PORT=3001
SEED_ON_STARTUP=false
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=replace-with-staging-webhook-secret
CORS_ORIGINS=https://staging.yourdomain.com
DEBUG=0

# Optional one-time bootstrap only (then set SEED_ON_STARTUP=false again):
# SEED_ON_STARTUP=true
# SEED_ADMIN_PASSWORD=<rotated>
# SEED_OWNER_PASSWORD=<rotated>
# SEED_PLAYER_PASSWORD=<rotated>

# --- Next.js (Vercel staging / preview) ---
METEOR_API_URL=https://api-staging.yourdomain.com
NEXT_PUBLIC_APP_URL=https://staging.yourdomain.com
AUTH_COOKIE_NAME=dink_auth_token
DEBUG=0
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<staging-restricted-key>
