# Copy to `.env` (root) and/or `apps/web/.env.local` as needed.
# P0-05/P0-06: this file documents the real env contract used by code.

# --- Mongo (local Docker Compose / Atlas) ---
MONGO_URL=mongodb://localhost:27017/dink?replicaSet=rs0
MONGO_URL_STANDALONE=mongodb://localhost:27017/dink

# --- Meteor API ---
ROOT_URL=http://localhost:3001
PORT=3001
METEOR_PORT=3001

# Comma-separated browser origins allowed by the API CORS middleware.
# Used by: apps/api/imports/api/rest/router.ts
# Default if unset: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Structured debug logs on the API when set to 1 (also on when NODE_ENV != production).
# Used by: apps/api/imports/lib/logger.ts
DEBUG=0

# Email transport (Meteor MAIL_URL). Placeholder — not wired to senders yet (Phase 1).
MAIL_URL=

# --- Next.js web ---
# Server-side BFF → Meteor (preferred). Fallback: NEXT_PUBLIC_METEOR_API_URL
METEOR_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# httpOnly cookie that stores the Meteor resume login token (not HMAC-signed).
# AUTH_COOKIE_SECRET was removed (P0-06) — unused; do not set.
AUTH_COOKIE_NAME=dink_auth_token

# Optional: force web debug logs in production when set to 1.
# Dev already logs debug when NODE_ENV != production.
# Used by: apps/web/src/lib/logger.ts
# DEBUG=0

# Google Maps JavaScript API (enable Maps JavaScript API on the key)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# NEXT_PUBLIC_METEOR_DDP_URL was removed (P0-06) — no DDP client in the web app yet.
# Re-add only when a realtime client is wired (Phase 2+).

# --- Payments (P1) ---
# stub = instant confirm (local/demo). paymongo = hosted checkout + webhook.
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# Public web URL used for PayMongo success/cancel redirects
APP_URL=http://localhost:3000
# PayMongo test keys (https://dashboard.paymongo.com) — required when PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=
# Webhook signing secret from PayMongo dashboard (or reuse PAYMENT_WEBHOOK_SECRET)
PAYMONGO_WEBHOOK_SECRET=

# --- Media (optional later; env only, not wired) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# --- Seed / bootstrap ---
# Local demo: true (default in non-prod when unset).
# Production / https ROOT_URL: defaults OFF unless SEED_ON_STARTUP=true AND
# all SEED_*_PASSWORD values are rotated away from Admin123!/Owner123!/Player123!.
# After any shared/staging bootstrap, set SEED_ON_STARTUP=false and rotate passwords.
SEED_ON_STARTUP=true
SEED_ADMIN_EMAIL=admin@dink.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_OWNER_EMAIL=owner@dink.local
SEED_OWNER_PASSWORD=Owner123!
SEED_PLAYER_EMAIL=player@dink.local
SEED_PLAYER_PASSWORD=Player123!
